# Copia questo file in backend/.env e inserisci la tua chiave
GEMINI_API_KEY=

# Piu' chiavi, separate da virgola: quando una tocca il limite lo stream passa
# alla successiva invece di aspettare. Se e' valorizzata ha la precedenza su
# GEMINI_API_KEY. Le chiavi devono stare su progetti Google DIVERSI: le quote
# del free tier si contano per progetto, non per chiave, e due chiavi dello
# stesso progetto pescano dallo stesso secchio.
# GEMINI_API_KEYS=chiave1,chiave2,chiave3

# opzionali
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# Temperatura di generazione: se la riga manca vale 0, che e' quello che
# vogliamo. Se la scrivi, dalle un valore — lasciata vuota fa fallire l'avvio.
GEMINI_TEMPERATURE=0
